# File system
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
else
  alias ls='ls -lh --color=auto'
  alias lsa='ls -a'
fi

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git
alias g='git'
alias gcm='git commit -m'

# tmux
alias tks='tmux kill-session -t'
alias tksvr='tmux kill-server'
alias tns='tmux new-session -ds'
tsw() {
  tmux swap-window -t "$1" && tmux select-window -t "$1"
}

# Apps
alias oc='opencode'

# A function, not an alias, so it replaces Omarchy's n() instead of shadowing it.
# Theirs runs `nvim .` with no arguments (docked neo-tree, no dashboard), which
# still leaked through \n and non-interactive use while this was an alias.
n() { command nvim "$@"; }
