{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "animations": true,
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "session.line.up": "ctrl+h",
    "session.line.down": "ctrl+j",
    "input.newline": ["shift+return", "ctrl+return"]
  }
}
